{
  "entities": {
    "Laboratory": {
      "title": "Laboratory Room",
      "description": "Represents a physical computer laboratory room with specific PC capacity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "capacity": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Maintenance", "Disabled"] }
      },
      "required": ["id", "name", "capacity", "status"]
    },
    "PCState": {
      "title": "PC Node State",
      "description": "Real-time state and assignment of an individual PC inside a laboratory.",
      "type": "object",
      "properties": {
        "pcNumber": { "type": "string" },
        "labId": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "Occupied", "Pending", "Maintenance"] },
        "currentUser": { "type": "string" },
        "currentUserName": { "type": "string" },
        "sessionExpiresAt": { "type": "string" }
      },
      "required": ["pcNumber", "labId", "status"]
    },
    "UserSessionRequest": {
      "title": "PC Booking Request",
      "description": "Log of requests submitted by students or approved by teachers/admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "labId": { "type": "string" },
        "labName": { "type": "string" },
        "pcNumber": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Cancelled", "Expired"] },
        "createdAt": { "type": "string" },
        "approvedAt": { "type": "string" }
      },
      "required": ["id", "userId", "labId", "pcNumber", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/laboratories/{labId}": {
      "schema": "Laboratory",
      "description": "Collection of physical laboratories managed by the academy."
    },
    "/laboratories/{labId}/pcs/{pcId}": {
      "schema": "PCState",
      "description": "Subcollection storing real-time statuses for every workstation grid node."
    },
    "/requests/{requestId}": {
      "schema": "UserSessionRequest",
      "description": "Global collection for session requests, warning timers, and history logs."
    }
  }
}