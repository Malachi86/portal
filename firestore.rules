
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the device banned?
    function isDeviceBanned() {
      let deviceId = request.headers.get('x-device-id', 'unknown'); // Custom header implementation or logic check
      return exists(/databases/$(database)/documents/banned_devices/$(deviceId));
    }

    // Helper: Global Lock check
    function isSystemAccessible() {
      return !isDeviceBanned();
    }

    // Helper: Check Role
    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    match /devices/{deviceId} {
      // Anyone can create their device entry on first visit
      allow create: if true;
      // Users can only update their own device lastVisit
      allow update: if request.resource.data.id == deviceId;
      // Admins can see all devices
      allow read: if request.auth != null && hasRole('admin');
    }

    match /banned_devices/{deviceId} {
      allow read: if true;
      allow write: if request.auth != null && hasRole('admin');
    }

    match /users/{userId} {
      // User can read their own profile
      allow read: if request.auth != null && (request.auth.uid == userId || hasRole('admin') || hasRole('teacher'));
      // Only Admins or self-update for lastSeen
      allow update: if request.auth != null && (request.auth.uid == userId || hasRole('admin'));
      allow create, delete: if request.auth != null && hasRole('admin');
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (hasRole('admin') || hasRole('teacher'));
    }

    match /sscpayments/{payId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || hasRole('admin') || hasRole('ssc_treasurer'));
      allow create: if request.auth != null;
      allow update: if request.auth != null && (hasRole('admin') || hasRole('ssc_treasurer'));
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if request.auth != null && hasRole('admin');
    }
    
    // Default deny for all other collections unless specified
    match /{document=**} {
      allow read, write: if request.auth != null && hasRole('admin');
    }
  }
}
